# 🤖 Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# 🐘 PostgreSQL Connection String (Neon, etc.)
# ssl=true is required for Neon
DATABASE_URL=postgres://user:password@hostname/dbname?sslmode=require

# 🌐 URL where your WebApp is hosted (e.g., https://your-app.onrender.com)
WEB_APP_URL=https://your-app.onrender.com

# 🔐 Admin Panel Password
ADMIN_PASSWORD=admin123

# 🔌 Port (default is 3000)
PORT=3000
